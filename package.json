{
  "name": "testreportium",
  "version": "0.2.1",
  "description": "Appium test reporter: smart, self-contained HTML test reports for Appium with Jest, WebdriverIO or any JUnit XML. One file, zero network calls, failure screenshots and recordings embedded, run history, flaky tests and quality gates.",
  "keywords": [
    "appium",
    "appium-reporter",
    "appium-report",
    "reporter",
    "test-reporter",
    "html-reporter",
    "jest-reporter",
    "wdio-reporter",
    "webdriverio",
    "jest",
    "mocha",
    "junit",
    "test-report",
    "html-report",
    "mobile-testing",
    "mobile-automation",
    "android",
    "ios",
    "uiautomator2",
    "xcuitest",
    "screenshots",
    "flaky-tests",
    "quality-gates",
    "test-automation",
    "qa"
  ],
  "license": "MIT",
  "author": "foyezkabir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foyezkabir/appium-test-reportium.git"
  },
  "homepage": "https://github.com/foyezkabir/appium-test-reportium#readme",
  "bugs": {
    "url": "https://github.com/foyezkabir/appium-test-reportium/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./jest": "./dist/adapters/jest.js",
    "./junit": "./dist/adapters/junit.js",
    "./step-recorder": "./dist/step-recorder.js",
    "./slug": "./dist/slug.js"
  },
  "bin": {
    "testreportium": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/fonts/OFL-*.txt",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "fonts": "node scripts/embed-fonts.mjs",
    "demo": "tsc && node scripts/demo.mjs && open demo/report.html"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.0"
  }
}
